  salesExecutiveProfileId String
  assignmentId            String?
  source                  PerformanceSource
  summary                 String?
  verdict                 String?
  rating                  Decimal?          @db.Decimal(3, 2)
  createdById             String
  evaluatedAt             DateTime          @default(now())
  archivedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  profile    SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  assignment CommandoAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy  User                  @relation("PerformanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scores     PerformanceScore[]

  @@index([salesExecutiveProfileId, source])
  @@index([assignmentId])
  @@index([createdById])
  @@index([evaluatedAt])
}

model PerformanceScore {
  id            String   @id @default(cuid())
  evaluationId  String
  metricCode    String
  metricLabel   String
  scoreValue    Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evaluation PerformanceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([metricCode])
}

// ─────────────────────────────────────────────
// Audit & notifications
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model InterventionGoal {
  id                      String                 @id @default(cuid())
  salesExecutiveProfileId String
  assignmentId            String?
  title                   String
  ownerUserId             String
  targetDate              DateTime?               @db.Date
  status                  InterventionGoalStatus @default(OPEN)
  progressNotes           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  profile    SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  assignment CommandoAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  owner      User                  @relation("InterventionGoalOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([salesExecutiveProfileId, status])
  @@index([assignmentId])
  @@index([ownerUserId])
}

model RecordAcknowledgement {
  id                      String   @id @default(cuid())
  userId                  String
  salesExecutiveProfileId String
  entityType              String
  entityId                String
  acknowledgedAt          DateTime @default(now())
  createdAt               DateTime @default(now())

  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile SalesExecutiveProfile  @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)

  @@unique([userId, entityType, entityId])
  @@index([salesExecutiveProfileId])
  @@index([entityType, entityId])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String?
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// SE workspace activity events
// ─────────────────────────────────────────────

model WorkspaceEvent {
  id                      String               @id @default(cuid())
  salesExecutiveProfileId String
  assignmentId            String?
  type                    WorkspaceEventType
  title                   String
  notes                   String?
  nextAction              String?
  urgency                 EventUrgency         @default(NOT_URGENT)
  importance              EventImportance      @default(IMPORTANT)
  status                  WorkspaceEventStatus @default(COMPLETED)
  eisenhowerCategory      EisenhowerCategory
  occurredAt              DateTime             @default(now())
  sourceType              String?
  sourceId                String?
  createdById             String
  archivedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  profile    SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  assignment CommandoAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy  User                  @relation("WorkspaceEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([salesExecutiveProfileId, occurredAt])
  @@index([salesExecutiveProfileId, type])
  @@index([salesExecutiveProfileId, eisenhowerCategory])
  @@index([assignmentId])
  @@index([createdById])
  @@index([sourceType, sourceId])
  @@index([archivedAt])
}
