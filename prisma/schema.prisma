generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum RoleCode {
  SUPER_ADMIN
  TEAM_LEAD
  COMMANDO_EXECUTIVE
  SALES_EXECUTIVE
  SALES_SUPPORT_EXECUTIVE
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  EXITED
}

enum InterventionOutcome {
  IMPROVED
  PARTIALLY_IMPROVED
  NOT_IMPROVED
  CONTINUED_MONITORING
  OTHER
}

enum InterventionGoalStatus {
  OPEN
  IN_PROGRESS
  MET
  NOT_MET
}

enum ReferralStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ReferralInitiatedBy {
  TEAM_LEAD
  COMMANDO
}

enum SwotSource {
  TEAM_LEAD
  COMMANDO
  SALES_EXECUTIVE
  SALES_SUPPORT_EXECUTIVE
}

/// What the SWOT is about (independent of who authored it via SwotSource).
enum SwotSubjectType {
  EXECUTIVE
  PROFILE
}

enum WeeklyReviewStatus {
  DRAFT
  SUBMITTED
}

enum DailyLogStatus {
  DRAFT
  SUBMITTED
}

enum EisenhowerCategory {
  DO_FIRST
  SCHEDULE
  DELEGATE
  ELIMINATE
}

enum EisenhowerTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum SnapshotPerformanceLevel {
  STRONG
  AVERAGE
  NEEDS_ATTENTION
}

enum SnapshotTrend {
  IMPROVING
  STABLE
  DECLINING
}

enum WorkspaceEventType {
  MONITORING
  COACHING
  FEEDBACK
  DAILY_LOG
  REVIEW
  ACTION
  SUPPORT
  INTERVENTION
  SWOT
  GENERAL
}

enum EventUrgency {
  URGENT
  NOT_URGENT
}

enum EventImportance {
  IMPORTANT
  NOT_IMPORTANT
}

enum WorkspaceEventStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionItemStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REPLACED
  CANCELLED
}

enum SupportRoleAssignmentStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum FeedbackSource {
  TEAM_LEAD
  COMMANDO
}

enum PerformanceSource {
  TEAM_LEAD
  COMMANDO
}

enum SupportTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum SupportTaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum MembershipRole {
  TEAM_LEAD
  SALES_EXECUTIVE
  SALES_SUPPORT_EXECUTIVE
  MEMBER
}

// ─────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  roleId       String
  /// Bumped on every login; tokens from older sessions are rejected (single active session).
  tokenVersion Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  teamMemberships TeamMembership[]

  salesExecutiveProfile SalesExecutiveProfile?

  assignmentsAsCommando  CommandoAssignment[] @relation("AssignmentCommando")
  assignmentsAsTeamLead  CommandoAssignment[] @relation("AssignmentTeamLead")
  referralsAsTeamLead    Referral[]           @relation("ReferralTeamLead")
  referralsAsCommando    Referral[]           @relation("ReferralCommando")
  referralsAcknowledged  Referral[]           @relation("ReferralAcknowledgedBy")
  recordAcknowledgements RecordAcknowledgement[]
  interventionGoals      InterventionGoal[]  @relation("InterventionGoalOwner")

  swotCreated            SwotAnalysis[]          @relation("SwotCreator")
  swotCorrected          SwotAnalysis[]          @relation("SwotCorrector")
  swotAsExecutive        SwotAnalysis[]          @relation("SwotExecutiveSubject")
  dailyLogsCreated       DailyLog[]              @relation("DailyLogCreator")
  dailyLogEntriesCreated DailyLogEntry[]         @relation("DailyLogEntryCreator")
  dailyLogsAsExecutive   DailyLog[]              @relation("DailyLogExecutiveSubject")
  weeklyReviewsCreated   WeeklyReview[]          @relation("WeeklyReviewCreator")
  weeklyReviewsAsExecutive WeeklyReview[]        @relation("WeeklyReviewExecutiveSubject")
  weeklyReviewAttendance WeeklyReviewAttendee[]
  syncEvalsCreated       SyncEvaluation[]        @relation("SyncEvalCreator")
  syncEvalsAsSupport     SyncEvaluation[]        @relation("SyncEvalSupport")
  eisenhowerCreated      EisenhowerTask[]        @relation("EisenhowerCreator")
  monitoringCreated      LiveMonitoringRecord[]  @relation("MonitoringCreator")
  monitoringAsExecutive  LiveMonitoringRecord[]  @relation("MonitoringExecutiveSubject")
  seMonitoringItemsCreated SeMonitoringChecklistItem[] @relation("SeMonitoringChecklistCreator")
  seMonitoringItemsAsExecutive SeMonitoringChecklistItem[] @relation("SeMonitoringChecklistExecutiveSubject")
  seMonitoringWeightsAsExecutive SeMonitoringChecklistWeight[] @relation("SeMonitoringWeightExecutiveSubject")
  actionItemsCreated     ActionItem[]            @relation("ActionItemCreator")
  actionItemsCompleted   ActionItem[]            @relation("ActionItemCompleter")
  actionItemAttachments  ActionItemAttachment[]  @relation("ActionItemAttachmentUploader")
  dailyLogEntryAttachments DailyLogEntryAttachment[] @relation("DailyLogEntryAttachmentUploader")
  feedbackCreated        Feedback[]              @relation("FeedbackCreator")
  feedbackAsExecutive    Feedback[]              @relation("FeedbackExecutiveSubject")
  performanceCreated     PerformanceEvaluation[] @relation("PerformanceCreator")
  supportTasksCreated    SupportTask[]           @relation("SupportTaskCreator")
  supportTasksAssignedBy SupportTask[]           @relation("SupportTaskAssignedBy")
  supportTasksAssigned   SupportTask[]           @relation("SupportTaskAssignee")
  supportTaskProgressNotes SupportTaskProgressNote[] @relation("SupportTaskProgressAuthor")
  supportTaskAttachments SupportTaskAttachment[] @relation("SupportTaskAttachmentUploader")
  supportTaskAssignmentEvents SupportTaskAssignmentEvent[] @relation("SupportTaskAssignmentActor")
  auditLogs              AuditLog[]              @relation("AuditActor")
  notifications          Notification[]          @relation("NotificationRecipient")
  salesSupportLinks      SalesSupportLink[]      @relation("SupportUser")
  supportLinksAssigned   SalesSupportLink[]      @relation("SupportLinkAssigner")
  supportLinksEnded      SalesSupportLink[]      @relation("SupportLinkEnder")
  supportRoleAssignments SupportRoleAssignment[] @relation("SupportRoleAssignee")
  supportRolesCreated    SupportRoleAssignment[] @relation("SupportRoleCreator")
  monitoringSupportInvolvements MonitoringSupportInvolvement[]
  workspaceEventsCreated WorkspaceEvent[]        @relation("WorkspaceEventCreator")
  dailyWorkLogs          DailyWorkLog[]          @relation("DailyWorkLogAuthor")
  dailyWorkCommitments   DailyWorkCommitment[]   @relation("DailyWorkCommitmentAuthor")
  refreshTokens          RefreshToken[]
  performanceSnapshotsAbout   InterventionPerformanceSnapshot[] @relation("SnapshotSubject")
  performanceSnapshotsCreated InterventionPerformanceSnapshot[] @relation("SnapshotCreator")
  snapshotEvidenceUploaded    InterventionSnapshotEvidence[]    @relation("SnapshotEvidenceUploader")
  handoffReportsAbout         AssignmentHandoffReport[]         @relation("HandoffReportSubject")
  handoffReportsCreated       AssignmentHandoffReport[]         @relation("HandoffReportCreator")
  handoffAttachmentsUploaded  AssignmentHandoffAttachment[]     @relation("HandoffAttachmentUploader")

  @@index([roleId])
  @@index([deletedAt])
  @@index([isActive])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  /// User.tokenVersion of the login session this token belongs to
  sessionVersion Int       @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// Org structure
// ─────────────────────────────────────────────

model Team {
  id          String    @id @default(cuid())
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships TeamMembership[]
  profiles    SalesExecutiveProfile[]
  assignments CommandoAssignment[]
  referrals   Referral[]
  swots       SwotAnalysis[]

  @@index([archivedAt])
  @@index([name])
}

model TeamMembership {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  roleInTeam MembershipRole @default(MEMBER)
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([teamId, isActive])
  @@index([userId, isActive])
  @@index([startedAt])
}

model SalesExecutiveProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  teamId    String
  displayName String
  employeeCode String?
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  assignments       CommandoAssignment[]
  referrals         Referral[]
  swots             SwotAnalysis[]
  dailyLogs         DailyLog[]
  weeklyReviews     WeeklyReview[]
  syncEvaluations   SyncEvaluation[]
  eisenhowerTasks   EisenhowerTask[]
  monitoringRecords LiveMonitoringRecord[]
  seMonitoringChecklistItems SeMonitoringChecklistItem[]
  seMonitoringChecklistWeights SeMonitoringChecklistWeight[]
  dailyWorkLogs     DailyWorkLog[]
  dailyWorkCommitments DailyWorkCommitment[]
  actionItems       ActionItem[]
  feedback          Feedback[]
  performanceEvals  PerformanceEvaluation[]
  salesSupportLinks SalesSupportLink[]
  supportRoleAssignments SupportRoleAssignment[]
  supportTasks      SupportTask[]
  interventionGoals InterventionGoal[]
  recordAcknowledgements RecordAcknowledgement[]
  workspaceEvents   WorkspaceEvent[]

  @@index([teamId])
  @@index([archivedAt])
  @@index([displayName])
}

/// Historical SE ↔ Sales Support pairing (not dependent on current team membership alone)
model SalesSupportLink {
  id                       String    @id @default(cuid())
  salesExecutiveProfileId  String
  salesSupportUserId       String
  startedAt                DateTime  @default(now())
  endedAt                  DateTime?
  isActive                 Boolean   @default(true)
  responsibilityType       String?
  note                     String?
  assignedById             String?
  endedById                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  profile      SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  supportUser  User                  @relation("SupportUser", fields: [salesSupportUserId], references: [id], onDelete: Restrict)
  assignedBy   User?                 @relation("SupportLinkAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  endedBy      User?                 @relation("SupportLinkEnder", fields: [endedById], references: [id], onDelete: SetNull)
  syncEvaluations SyncEvaluation[]
  roleAssignments SupportRoleAssignment[]
  supportTasks SupportTask[]
  monitoringInvolvements MonitoringSupportInvolvement[]

  @@index([salesExecutiveProfileId, isActive])
  @@index([salesSupportUserId, isActive])
  @@index([assignedById])
  @@index([endedById])
}

// ─────────────────────────────────────────────
// Commando lifecycle
// ─────────────────────────────────────────────

model CommandoAssignment {
  id                       String           @id @default(cuid())
  salesExecutiveProfileId  String
  commandoUserId           String
  teamLeadUserId           String
  teamId                   String
  startedAt                DateTime
  endedAt                  DateTime?
  status                   AssignmentStatus @default(ACTIVE)
  completionReason         String?
  outcome                  InterventionOutcome?
  initialProblem           String?
  interventionProvided     String?
  improvementObserved      String?
  remainingGaps            String?
  finalCommandoAssessment    String?
  finalTeamLeadView        String?
  transferredFromId       String?
  transferReason           String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  profile  SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  commando User                  @relation("AssignmentCommando", fields: [commandoUserId], references: [id], onDelete: Restrict)
  teamLead User                  @relation("AssignmentTeamLead", fields: [teamLeadUserId], references: [id], onDelete: Restrict)
  team     Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  transferredFrom CommandoAssignment?  @relation("AssignmentTransfer", fields: [transferredFromId], references: [id], onDelete: SetNull)
  transferredTo    CommandoAssignment[] @relation("AssignmentTransfer")

  referrals         Referral[]
  dailyLogs         DailyLog[]
  weeklyReviews     WeeklyReview[]
  syncEvaluations   SyncEvaluation[]
  eisenhowerTasks   EisenhowerTask[]
  monitoringRecords LiveMonitoringRecord[]
  actionItems       ActionItem[]
  feedback          Feedback[]
  performanceEvals  PerformanceEvaluation[]
  supportRoleAssignments SupportRoleAssignment[]
  supportTasks      SupportTask[]
  interventionGoals InterventionGoal[]
  workspaceEvents   WorkspaceEvent[]
  handoffReports    AssignmentHandoffReport[]

  @@index([salesExecutiveProfileId, status])
  @@index([commandoUserId, status])
  @@index([teamLeadUserId, status])
  @@index([teamId])
  @@index([startedAt])
  @@index([endedAt])
}

model Referral {
  id                         String         @id @default(cuid())
  salesExecutiveProfileId    String
  teamLeadUserId             String
  teamId                     String
  commandoUserId             String
  assignmentId               String?
  profileName                String
  whySalesIsDown             String
  whatIsTheGap               String
  detailedSummaryOfGap       String
  supportAlreadyProvided     String
  supportRequiredFromCommando String
  recommendationFocus        String
  priority1                  String?
  priority2                  String?
  priority3                  String?
  initiatedBy                ReferralInitiatedBy @default(TEAM_LEAD)
  requestReason              String?
  informationProvidedAt      DateTime?
  rejectionReason            String?
  rejectedAt                 DateTime?
  status                     ReferralStatus @default(SUBMITTED)
  acknowledgedAt             DateTime?
  acknowledgedById           String?
  acknowledgementNote        String?
  completedAt                DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  profile    SalesExecutiveProfile @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  teamLead   User                  @relation("ReferralTeamLead", fields: [teamLeadUserId], references: [id], onDelete: Restrict)
  team       Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  commando   User                  @relation("ReferralCommando", fields: [commandoUserId], references: [id], onDelete: Restrict)
  acknowledgedBy User?            @relation("ReferralAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  assignment CommandoAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  performanceSnapshots InterventionPerformanceSnapshot[]
  snapshotEvidence     InterventionSnapshotEvidence[]

  @@index([salesExecutiveProfileId])
  @@index([teamLeadUserId])
  @@index([commandoUserId])
  @@index([teamId])
  @@index([assignmentId])
  @@index([status])
  @@index([createdAt])
}

/// Team Lead's performance snapshot of one person (SE or linked SSE), frozen
/// at approval so the Commando always sees what was originally handed over.
model InterventionPerformanceSnapshot {
  id                 String                   @id @default(cuid())
  referralId         String
  subjectUserId      String
  /// SALES_EXECUTIVE | SALES_SUPPORT_EXECUTIVE at the time of the snapshot
  subjectRole        RoleCode
  subjectName        String
  overallPerformance SnapshotPerformanceLevel
  trend              SnapshotTrend
  insights           String[]
  note               String
  salesAchieved      Decimal?                 @db.Decimal(14, 2)
  salesTarget        Decimal?                 @db.Decimal(14, 2)
  achievementPct     Decimal?                 @db.Decimal(7, 2)
  /// SIX_MONTHS | ALL_HISTORY
  periodKind         String
  periodStart        DateTime
  periodEnd          DateTime
  createdById        String
  createdAt          DateTime                 @default(now())

  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  subjectUser User     @relation("SnapshotSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("SnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([referralId, subjectUserId])
  @@index([subjectUserId])
  @@index([createdById])
}

/// Optional supporting documents attached to the Team Lead's snapshot (Cloudflare R2).
model InterventionSnapshotEvidence {
  id           String   @id @default(cuid())
  referralId   String
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime @default(now())

  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("SnapshotEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([referralId, createdAt])
  @@index([uploadedById])
}

/// Commando's write-up of one person (SE or linked SSE) for the intervention
/// period, required when handing the Sales Executive back to the Team Lead.
/// Visible to the Team Lead and Super Admin only.
model AssignmentHandoffReport {
  id             String   @id @default(cuid())
  assignmentId   String
  subjectUserId  String
  /// SALES_EXECUTIVE | SALES_SUPPORT_EXECUTIVE at handoff time
  subjectRole    RoleCode
  subjectName    String
  description    String
  salesAchieved  Decimal? @db.Decimal(14, 2)
  salesTarget    Decimal? @db.Decimal(14, 2)
  achievementPct Decimal? @db.Decimal(7, 2)
  periodStart    DateTime
  periodEnd      DateTime
  createdById    String
  createdAt      DateTime @default(now())

  assignment  CommandoAssignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subjectUser User                          @relation("HandoffReportSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdBy   User                          @relation("HandoffReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attachments AssignmentHandoffAttachment[]

  @@unique([assignmentId, subjectUserId])
  @@index([subjectUserId])
  @@index([createdById])
}

/// Optional supporting documents on a handoff report (Cloudflare R2).
model AssignmentHandoffAttachment {
  id           String   @id @default(cuid())
  reportId     String
  storageKey   String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime @default(now())

  report     AssignmentHandoffReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy User                    @relation("HandoffAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────
// SWOT
// ─────────────────────────────────────────────

model SwotAnalysis {
  id                      String          @id @default(cuid())
  /// PROFILE subject — sales profile/workspace (null when EXECUTIVE)
  salesExecutiveProfileId String?
  /// EXECUTIVE subject — person User.id (null when PROFILE)
  executiveUserId         String?
  subjectType             SwotSubjectType
  /// Team for profile SWOT / SE executive context; optional for SSE executive SWOT
  teamId                  String?
  assignmentId            String?
  source                  SwotSource
  strength                String
  weakness                String
  opportunity             String
  threat                  String
  /** Numbered points: [{ id, text, visible }]. Subject executive sees only visible:true. */
  strengthPoints          Json            @default("[]")
  weaknessPoints          Json            @default("[]")
  opportunityPoints       Json            @default("[]")
  threatPoints            Json            @default("[]")
  versionNumber           Int             @default(1)
  supersedesId            String?
  /** When true, the subject executive (person) may view this SWOT version. */
  visibleToSalesExecutive Boolean         @default(false)
  visibleStrength         Boolean         @default(false)
  visibleWeakness         Boolean         @default(false)
  visibleOpportunity      Boolean         @default(false)
  visibleThreat           Boolean         @default(false)
  createdById             String
  /** Set when a Super Admin corrected points; createdById stays the original author. */
  correctedById           String?
  correctedAt             DateTime?
  correctionReason        String?
  archivedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  profile       SalesExecutiveProfile? @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser User?                  @relation("SwotExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  team          Team?                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation("SwotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  correctedBy   User?                  @relation("SwotCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  supersedes    SwotAnalysis?          @relation("SwotVersionChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  SwotAnalysis[]         @relation("SwotVersionChain")

  @@index([salesExecutiveProfileId, source])
  @@index([salesExecutiveProfileId, source, versionNumber])
  @@index([executiveUserId, source])
  @@index([executiveUserId, source, versionNumber])
  @@index([subjectType, salesExecutiveProfileId, source])
  @@index([subjectType, executiveUserId, source])
  @@index([teamId])
  @@index([assignmentId])
  @@index([createdById])
  @@index([createdAt])
  @@index([supersedesId])
}

// ─────────────────────────────────────────────
// Daily coaching logs
// ─────────────────────────────────────────────

model ActivityType {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries DailyLogEntry[]

  @@index([isActive])
}

/// One Daily Log per subject (SE profile or Support user) per calendar day.
model DailyLog {
  id                      String         @id @default(cuid())
  /// Set for Sales Executive coaching logs
  salesExecutiveProfileId String?
  /// Set for Sales Support coaching logs (XOR with profile)
  executiveUserId         String?
  assignmentId            String?
  /// Calendar day for this log (date-only).
  logDate                 DateTime       @db.Date
  status                  DailyLogStatus @default(DRAFT)
  submittedAt             DateTime?
  createdById             String
  archivedAt              DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  profile       SalesExecutiveProfile? @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser User?                  @relation("DailyLogExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  assignment    CommandoAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("DailyLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries       DailyLogEntry[]

  @@unique([salesExecutiveProfileId, logDate])
  @@unique([executiveUserId, logDate])
  @@index([salesExecutiveProfileId])
  @@index([executiveUserId])
  @@index([assignmentId])
  @@index([createdById])
  @@index([logDate])
  @@index([status])
}

/// Individual activity recorded inside a Daily Log.
model DailyLogEntry {
  id               String               @id @default(cuid())
  dailyLogId       String
  activityTypeId   String
  sessionTitle     String
  observation      String
  evidence         String?
  seResponse       String?
  coachingGiven    String?
  expectedChange   String?
  followUp         String?
  /// Set during Review & Prioritize submit (null = not prioritized).
  urgency          EventUrgency?
  importance       EventImportance?
  eisenhowerCategory EisenhowerCategory?
  /// Prevents duplicate Eisenhower tasks on retry/resubmit.
  eisenhowerTaskId String?              @unique
  sortOrder        Int                  @default(0)
  loggedAt         DateTime             @default(now())
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  dailyLog     DailyLog     @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DailyLogEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attachments  DailyLogEntryAttachment[]

  @@index([dailyLogId])
  @@index([activityTypeId])
  @@index([createdById])
  @@index([loggedAt])
}

/// Optional screenshot evidence on a Daily Log activity (Cloudflare R2).
model DailyLogEntryAttachment {
  id           String   @id @default(cuid())
  entryId      String
  /// Cloudflare R2 object key
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int?
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())

  entry      DailyLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("DailyLogEntryAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([uploadedById])
  @@index([storageKey])
}

/// LOG = work completed; COMMITMENT = planned for the day (locked once added).
enum DailyWorkEntryKind {
  LOG
  COMMITMENT
}

/// Executive self-reported daily work (SE or SSE). Multiple per day allowed.
/// Separate from Commando DailyLog coaching journals.
model DailyWorkLog {
  id                      String    @id @default(cuid())
  /// Author user — SE or SSE
  authorUserId            String
  /// Set when author is a Sales Executive (scope for TL/Commando)
  salesExecutiveProfileId String?
  kind                    DailyWorkEntryKind @default(LOG)
  /// Display label; for structured entries "List item · Sub item"
  activity                String
  /// Structured entries: activity code from the role's activity config
  listItem                String?
  subItem                 String?
  /// Completed count (LOG) or target (COMMITMENT)
  count                   Int?
  /// Author-entered free text, e.g. "2min - 5min"
  timeRange               String?
  /// Daily Collection only
  totalAmount             Decimal?  @db.Decimal(14, 2)
  notes                   String?
  /// Activity timestamp (date + time)
  loggedAt                DateTime
  /// Author-entered task start / end; set together or not at all
  startedAt               DateTime?
  endedAt                 DateTime?
  /// Server-computed from startedAt → endedAt
  durationMinutes         Int?
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  author      User                    @relation("DailyWorkLogAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  profile     SalesExecutiveProfile?  @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  attachments DailyWorkLogAttachment[]

  @@index([authorUserId, loggedAt])
  @@index([authorUserId, kind, loggedAt])
  @@index([salesExecutiveProfileId, loggedAt])
  @@index([loggedAt])
}

/// Screenshots / images on a Daily Work Log entry (uploaded by the entry author).
model DailyWorkLogAttachment {
  id          String   @id @default(cuid())
  logId       String
  /// Cloudflare R2 object key
  storageKey  String
  fileName    String
  contentType String
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  log DailyWorkLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, createdAt])
}

/// Start-of-day plan written by an SE / SSE before their first Daily Work Log entry.
model DailyWorkCommitment {
  id                      String   @id @default(cuid())
  authorUserId            String
  /// Set when author is a Sales Executive (scope for TL/Commando)
  salesExecutiveProfileId String?
  /// Author's local calendar day
  commitDate              DateTime @db.Date
  commitment              String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  author  User                   @relation("DailyWorkCommitmentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  profile SalesExecutiveProfile? @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)

  @@unique([authorUserId, commitDate])
  @@index([salesExecutiveProfileId, commitDate])
}

// ─────────────────────────────────────────────
// Weekly reviews
// ─────────────────────────────────────────────

model WeeklyReview {
  id                      String             @id @default(cuid())
  /// Set for Sales Executive reviews
  salesExecutiveProfileId String?
  /// Set for Sales Support reviews (XOR with profile)
  executiveUserId         String?
  assignmentId            String?
  commandoUserId          String?
  teamLeadUserId          String
  weekLabel               String
  weekStartDate           DateTime           @db.Date
  meetingDate             DateTime
  /// Meeting room / location label
  roomName                String?
  /// Local meeting time as HH:mm (24h)
  meetingTime             String?
  /// Cloudflare R2 object key for uploaded minutes
  meetingMinutesKey         String?
  meetingMinutesFileName    String?
  meetingMinutesContentType String?
  meetingMinutesSize        Int?
  meetingMinutesUploadedAt  DateTime?
  performanceSummary      String
  whatWentWell            String
  improvement             String
  nextWeekAction          String
  status                  WeeklyReviewStatus @default(DRAFT)
  submittedAt             DateTime?
  createdById             String
  archivedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  profile       SalesExecutiveProfile? @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser User?                  @relation("WeeklyReviewExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  assignment    CommandoAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("WeeklyReviewCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendees     WeeklyReviewAttendee[]
  actionItems   ActionItem[]

  @@index([salesExecutiveProfileId])
  @@index([executiveUserId])
  @@index([assignmentId])
  @@index([commandoUserId])
  @@index([teamLeadUserId])
  @@index([status])
  @@index([weekStartDate])
  @@index([meetingDate])
  @@index([createdById])
}

model WeeklyReviewAttendee {
  id             String   @id @default(cuid())
  weeklyReviewId String
  userId         String
  signedAt       DateTime?
  createdAt      DateTime @default(now())

  weeklyReview WeeklyReview @relation(fields: [weeklyReviewId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([weeklyReviewId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Sales support sync evaluation
