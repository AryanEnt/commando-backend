  title                   String
  description             String?
  purpose                 String?
  priority                SupportTaskPriority @default(MEDIUM)
  status                  SupportTaskStatus   @default(PENDING)
  dueDate                 DateTime?
  completedAt             DateTime?
  completionNotes         String?
  blockedReason           String?
  blockedAt               DateTime?
  salesExecutiveProfileId String
  salesSupportUserId      String
  assignedById            String
  createdById             String
  assignmentId            String?
  salesSupportLinkId      String?
