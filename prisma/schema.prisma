// ─────────────────────────────────────────────
// Live monitoring
// ─────────────────────────────────────────────

model MonitoringCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklistItems             MonitoringChecklistItem[]
  records                    LiveMonitoringRecord[]
  seMonitoringChecklistItems SeMonitoringChecklistItem[]
  seMonitoringChecklistWeights SeMonitoringChecklistWeight[]

  @@index([isActive])
  @@index([sortOrder])
}

model MonitoringChecklistItem {
  id            String    @id @default(cuid())
  categoryId    String
  code          String
  label         String
  sortOrder     Int       @default(0)
  /// Default weight (%) when applying the admin template to an SE. 0–100.
  defaultWeight Int       @default(0)
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category            MonitoringCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  responses           MonitoringChecklistResponse[]
  seRemovals          SeMonitoringChecklistItem[]     @relation("SeRemovedTemplateItem")
  seWeightOverrides   SeMonitoringChecklistWeight[]

  @@unique([categoryId, code])
  @@index([categoryId, isActive])
}

/// Subject-specific checklist customization (SE profile or Support user). Never mutates global template items.
/// kind=CUSTOM: additional item for this subject + category
/// kind=TEMPLATE_REMOVED: hide a global template item for this subject + category
model SeMonitoringChecklistItem {
  id                      String    @id @default(cuid())
  /// Set for Sales Executive checklist customization
  salesExecutiveProfileId String?
  /// Set for Sales Support checklist customization (XOR with profile)
  executiveUserId         String?
  categoryId              String
  kind                    String
  sourceTemplateItemId    String?
  label                   String?
  description             String?
  sortOrder               Int       @default(0)
  /// Weight (%) for CUSTOM items. New items default to 0.
  weight                  Int       @default(0)
  isActive                Boolean   @default(true)
  createdById             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile            SalesExecutiveProfile?        @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser      User?                         @relation("SeMonitoringChecklistExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  category           MonitoringCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceTemplateItem MonitoringChecklistItem?      @relation("SeRemovedTemplateItem", fields: [sourceTemplateItemId], references: [id], onDelete: Restrict)
  createdBy          User                          @relation("SeMonitoringChecklistCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responses          MonitoringChecklistResponse[]

  @@index([salesExecutiveProfileId, categoryId, isActive])
  @@index([executiveUserId, categoryId, isActive])
  @@index([sourceTemplateItemId])
  @@index([createdById])
}

/// Subject-specific weight override for a template checklist item.
/// Once present for a subject+category, template defaultWeight changes no longer apply.
model SeMonitoringChecklistWeight {
  id                      String   @id @default(cuid())
  /// Set for Sales Executive weight overrides
  salesExecutiveProfileId String?
  /// Set for Sales Support weight overrides (XOR with profile)
  executiveUserId         String?
  categoryId              String
  sourceTemplateItemId    String
  weight                  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  profile            SalesExecutiveProfile? @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser      User?                  @relation("SeMonitoringWeightExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  category           MonitoringCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceTemplateItem MonitoringChecklistItem @relation(fields: [sourceTemplateItemId], references: [id], onDelete: Restrict)

  @@unique([salesExecutiveProfileId, categoryId, sourceTemplateItemId], map: "SeMonWeight_profile_cat_tpl_key")
  @@unique([executiveUserId, categoryId, sourceTemplateItemId], map: "SeMonWeight_exec_cat_tpl_key")
  @@index([salesExecutiveProfileId, categoryId], map: "SeMonWeight_profile_cat_idx")
  @@index([executiveUserId, categoryId], map: "SeMonWeight_exec_cat_idx")
  @@index([sourceTemplateItemId], map: "SeMonWeight_tpl_idx")
}

model LiveMonitoringRecord {
  id                      String    @id @default(cuid())
  /// Set for Sales Executive monitoring sessions
  salesExecutiveProfileId String?
  /// Set for Sales Support monitoring sessions (XOR with profile)
  executiveUserId         String?
  assignmentId            String?
  categoryId              String
  observation             String?
  /// Weighted score (0–100) frozen at session create. Null if all items were N/A.
  scorePercent            Float?
  createdById             String
  observedAt              DateTime  @default(now())
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile       SalesExecutiveProfile?        @relation(fields: [salesExecutiveProfileId], references: [id], onDelete: Restrict)
  executiveUser User?                         @relation("MonitoringExecutiveSubject", fields: [executiveUserId], references: [id], onDelete: Restrict)
  assignment    CommandoAssignment?           @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  category      MonitoringCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     User                          @relation("MonitoringCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responses     MonitoringChecklistResponse[]
  supportInvolvements MonitoringSupportInvolvement[]

  @@index([salesExecutiveProfileId])
  @@index([executiveUserId])
  @@index([assignmentId])
  @@index([categoryId])
  @@index([createdById])
  @@index([observedAt])
}

/// Snapshot of Sales Support involvement on a monitoring session (historical integrity)
model MonitoringSupportInvolvement {
  id                         String   @id @default(cuid())
  recordId                   String
  salesSupportUserId         String
  salesSupportLinkId         String?
  displayNameSnapshot        String
  responsibilityTypeSnapshot String?
  createdAt                  DateTime @default(now())

  record           LiveMonitoringRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  salesSupportUser User                 @relation(fields: [salesSupportUserId], references: [id], onDelete: Restrict)
  salesSupportLink SalesSupportLink?    @relation(fields: [salesSupportLinkId], references: [id], onDelete: SetNull)

  @@unique([recordId, salesSupportUserId])
  @@index([recordId])
  @@index([salesSupportUserId])
  @@index([salesSupportLinkId])
}

model MonitoringChecklistResponse {
  id                   String   @id @default(cuid())
  recordId             String
  checklistItemId      String?
  seChecklistItemId    String?
  labelSnapshot        String
  descriptionSnapshot  String?
  codeSnapshot         String?
  sortOrderSnapshot    Int      @default(0)
  /// Weight (%) frozen at session create for historical scoring.
  weightSnapshot       Int      @default(0)
  sourceType           String   @default("TEMPLATE")
  value                String
  createdAt            DateTime @default(now())

  record          LiveMonitoringRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  checklistItem   MonitoringChecklistItem?  @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  seChecklistItem SeMonitoringChecklistItem? @relation(fields: [seChecklistItemId], references: [id], onDelete: SetNull)

  @@index([checklistItemId])
  @@index([seChecklistItemId])
  @@index([recordId])
}

// ─────────────────────────────────────────────
// Sales Support role assignment (on-demand support)
// ─────────────────────────────────────────────

model SupportRoleAssignment {
  id                      String                      @id @default(cuid())
  salesExecutiveProfileId String
  salesSupportUserId      String
  salesSupportLinkId      String?
  assignmentId            String?
  primaryResponsibility   String
  status                  SupportRoleAssignmentStatus @default(ACTIVE)
  replacesId              String?
  createdById             String
