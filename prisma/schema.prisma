  @@index([salesSupportLinkId])
  @@index([assignmentId])
  @@index([createdById])
  @@index([replacesId])
  @@index([createdAt])
}

model SupportRoleShouldDoItem {
  id               String   @id @default(cuid())
  roleAssignmentId String
  text             String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  roleAssignment SupportRoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)

  @@index([roleAssignmentId, sortOrder])
}

model SupportRoleShouldNotDoItem {
  id               String   @id @default(cuid())
  roleAssignmentId String
  text             String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  roleAssignment SupportRoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)

  @@index([roleAssignmentId, sortOrder])
}

// ─────────────────────────────────────────────
// Sales Support Executive tasks (Commando-assigned)
