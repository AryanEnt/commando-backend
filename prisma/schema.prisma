  @@index([salesExecutiveProfileId])
  @@index([salesSupportUserId])
  @@index([assignmentId])
  @@index([createdById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Eisenhower matrix
// ─────────────────────────────────────────────

model EisenhowerTask {
  id                      String                @id @default(cuid())
  salesExecutiveProfileId String
  assignmentId            String?
  month                   DateTime              @db.Date
