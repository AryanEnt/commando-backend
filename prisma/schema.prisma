// ─────────────────────────────────────────────
// Action items
// ─────────────────────────────────────────────

model ActionItem {
  id                      String           @id @default(cuid())
  salesExecutiveProfileId String
  assignmentId            String?
  weeklyReviewId          String?
  title                   String
  description             String?
