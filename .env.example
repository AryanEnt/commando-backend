# Environment
NODE_ENV=development
PORT=4000

# PostgreSQL
# docker compose (this repo) maps 5432; a local cluster may use 5433
DATABASE_URL="postgresql://commando:commando@localhost:5432/commando?schema=public"

# Auth — generate unique secrets for any non-local environment
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"
COOKIE_SECURE="false"
# Comma-separated browser origins. Include the live FE host, e.g. http://10.80.80.225:3001
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://10.80.80.225:3001"

# Optional production-oriented knobs
LOG_LEVEL="debug"
REQUEST_TIMEOUT_MS="30000"
SHUTDOWN_TIMEOUT_MS="10000"
LOGIN_RATE_LIMIT_MAX="20"
LOGIN_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX="300"
API_RATE_LIMIT_WINDOW_MS="60000"
ACCESS_COOKIE_MAX_AGE_MS="900000"

# Seed: omit or true in development. Never set in production.
# SEED_DEMO_USERS="true"

# Cloudflare R2 (meeting minutes + support-task screenshots). Create an R2 API token with Object Read & Write.
# Endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Configure CORS on the bucket to allow PUT from your frontend origin.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional custom/public domain (no trailing slash), e.g. https://files.example.com
# R2_PUBLIC_BASE_URL=""
